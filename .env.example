# Runtime configuration (use non-production placeholder values only)
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://jobquest:local-only@127.0.0.1:5432/jobquest_dev
DIRECT_URL=postgresql://jobquest:local-only@127.0.0.1:5432/jobquest_dev
TEST_DATABASE_URL=postgresql://jobquest:test-only@127.0.0.1:5432/jobquest_test

# Migration-only source; never use DATABASE_PATH as a PostgreSQL URL
SQLITE_SOURCE_PATH=/secure/path/jobsearch.sqlite3

# Required only while running `npm run seed`
MANAGER_USERNAME=manager
MANAGER_PIN=0123
MANAGER_FULL_NAME=JobQuest Manager

